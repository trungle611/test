# Điền khóa thật trong backend/.env; không đưa khóa vào frontend hoặc Git.
GEMINI_API_KEY=
# Khóa dự phòng phải khác khóa chính; có thể để trống.
GEMINI_FALLBACK_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Khi triển khai, đặt chuỗi ngẫu nhiên ít nhất 32 ký tự. Local để trống sẽ tự
# sinh khóa bền trong backend/.runtime/auth-secret; không commit/chia sẻ file này.
AUTH_SECRET=
# Local tự tìm database cũ; dự án mới lưu trong backend/.runtime.
# APP_DATA_DIR nhận đường dẫn tuyệt đối hoặc tương đối so với backend/.
APP_ENV=local
APP_DATA_DIR=
DATABASE_URL=
SCAN_UPLOAD_DIR=
# Domain frontend đầy đủ, phân cách bằng dấu phẩy; không có dấu / cuối.
FRONTEND_ORIGINS=
ALLOW_VERCEL_PREVIEWS=0
